{
  "manifest_version": 3,
  "name": "Goodreads Translation Marker",
  "description": "Marks on the Goodreads recommendations page whether each book has an edition in your chosen language; can hide or bulk-skip the rest.",
  "version": "2.3.1",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.goodreads.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Goodreads Translation Marker"
  },
  "content_scripts": [
    {
      "matches": ["https://www.goodreads.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
